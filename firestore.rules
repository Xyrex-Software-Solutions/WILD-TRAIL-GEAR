rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAdmin() {
      return request.auth != null;
    }

    // --- Collection Rules ---

    // Public catalog needs to read items, but only admin can manage them
    match /rental_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer data is sensitive and only for internal admin use
    match /rental_customers/{customerId} {
      allow read, write: if isAdmin();
    }

    // Rental records and financial data are strictly admin-only
    match /rental_records/{recordId} {
      allow read, write: if isAdmin();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
